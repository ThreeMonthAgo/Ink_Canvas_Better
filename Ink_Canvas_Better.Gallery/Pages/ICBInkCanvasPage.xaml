<Page x:Class="Ink_Canvas_Better.Gallery.Pages.ICBInkCanvasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ink_Canvas_Better.Gallery.Pages"
      xmlns:controls="Ink_Canvas_Better.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ICBInkCanvasPage">
    <Page.Resources>
        <Style x:Key="Button" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="auto,auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Pen" Style="{StaticResource Button}" Click="Button_Pen_Click"/>
            <Button Content="EraseByStroke" Style="{StaticResource Button}" Click="Button_EraseByStroke_Click"/>
            <Button Content="EraseByPoint" Style="{StaticResource Button}" Click="Button_EraseByPoint_Click"/>
            <Button Content="Select" Style="{StaticResource Button}" Click="Button_Select_Click"/>
            <Button Content="Redo" Style="{StaticResource Button}" Click="Button_Redo_Click"/>
            <Button Content="Undo" Style="{StaticResource Button}" Click="Button_Undo_Click"/>
            <Button Content="Clear" Style="{StaticResource Button}" Click="Button_Clear_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Width:" VerticalAlignment="Center"/>
            <TextBox Name="TextBox_Width" InputScope="Number" MinWidth="60" Text="20" TextChanged="TextBox_TextChanged" BorderBrush="AliceBlue" VerticalContentAlignment="Center"/>
            <TextBlock Text="Height:" VerticalAlignment="Center"/>
            <TextBox Name="TextBox_Height" InputScope="Number" MinWidth="60" Text="20" TextChanged="TextBox_TextChanged" BorderBrush="AliceBlue" VerticalContentAlignment="Center"/>
            <ComboBox Name="ComboBox_StrokeType" MinWidth="60" SelectionChanged="ComboBox_StrokeType_SelectionChanged"/>
        </StackPanel>
        <controls:ICBInkCanvas
            Loaded="ICBInkCanvas_Loaded"
            Name="ICBInkCanvas"
            Background="Transparent"
            Grid.Row="2"/>
    </Grid>
</Page>
