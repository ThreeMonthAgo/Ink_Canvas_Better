<Page x:Class="Ink_Canvas_Better.Gallery.Pages.FloatingBarControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ink_Canvas_Better.Gallery.Pages"
      xmlns:controls="Ink_Canvas_Better.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=local:FloatingBarControlPageViewModel}"
      Title="FloatingBarControlPage">

    <StackPanel>
        <TextBlock Text="Note: iNKORE.UI.WPF.Modern is required" Foreground="OrangeRed"/>
        <TextBlock Text="FloatingBarControl with Popup"/>
        <controls:FloatingBarControl
            HorizontalAlignment="Left"
            Click="FloatingBarControl_WithPopup_Click"
            IsOpen="{Binding IsOpen_WithPopup, Mode=TwoWay}"
            Text="Example">
            <controls:FloatingBarControl.PopupContent>
                <TextBlock Text="This is the content of the popup"/>
            </controls:FloatingBarControl.PopupContent>
        </controls:FloatingBarControl>
    </StackPanel>
</Page>
