<Window x:Class="Ink_Canvas_Better.View.Windows.FloatingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ink_Canvas_Better.View.Windows"
        xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModel.Windows"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowVM}"
        Title="FloatingBarWindow">
    <Grid>
        <ItemsControl ItemsSource="{Binding FloatingBarCollection}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </Grid>
</Window>
