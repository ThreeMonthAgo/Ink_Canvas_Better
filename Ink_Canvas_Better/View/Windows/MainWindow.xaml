<Window x:Class="Ink_Canvas_Better.View.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ink_Canvas_Better"
        xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModel.Windows"
        xmlns:ICBControl="Ink_Canvas_Better.Controls"
        mc:Ignorable="d"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Left="0"
        Top="0"
        AllowsTransparency="True"
        Background="Transparent"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowVM}"
        d:Height="450" d:Width="800">
    <Grid>
        <ICBControl:ICBInkCanvas
            Name="InkCanvas"
            Background="Transparent"
            Cursor="Pen"
            DefaultDrawingAttributes="{Binding CurrentDrawingAttributes}"
            ForceCursor="False"
            IsManipulationEnabled="True"/>
    </Grid>
</Window>
