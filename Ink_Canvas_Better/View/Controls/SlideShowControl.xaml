<UserControl x:Class="Ink_Canvas_Better.View.Controls.SlideShowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ink_Canvas_Better.View.Controls"
             xmlns:ICBControls="Ink_Canvas_Better.Controls"
             xmlns:iuw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:fb="clr-namespace:Ink_Canvas_Better.View.Controls.FloatingBar"
             xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModel.Controls"
             d:DataContext="{d:DesignInstance Type=vm:SlideShowControlVM}"
             mc:Ignorable="d">
    <Border Background="{DynamicResource {x:Static iuwm:ThemeKeys.ApplicationPageBackgroundThemeBrushKey}}"
            BorderBrush="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeBrushKey}}"
            BorderThickness="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeThicknessKey}}"
            CornerRadius="8">
        <iuw:SimpleStackPanel
            Orientation="{Binding Orientation}">
            <ICBControls:FloatingBarButton
                Text="{DynamicResource Text_Previous}"
                Icon="{x:Static iuwm:FluentSystemIcons.Previous_24_Regular}"
                Click="FloatingBarButton_Previous_Click"/>
            <ICBControls:FloatingBarButton
                Text="{DynamicResource Text_Next}"
                Icon="{x:Static iuwm:FluentSystemIcons.Next_24_Regular}"
                Click="FloatingBarButton_Next_Click"/>
        </iuw:SimpleStackPanel>
    </Border>
</UserControl>
