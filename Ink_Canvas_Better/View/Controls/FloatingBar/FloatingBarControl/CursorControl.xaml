<UserControl x:Class="Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl.CursorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl"
             xmlns:ICBControls="Ink_Canvas_Better.Controls"
             xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModel.Controls.FloatingBar.FloatingBarControl"
             d:DataContext="{d:DesignInstance Type=vm:CursorControlVM}"
             mc:Ignorable="d">
    <ICBControls:FloatingBarControl
        ImageSource="{DynamicResource Image.FUI.Cursor}"
        Text="{DynamicResource Text_Cursor}"
        TextVisibility="{Binding TextVisibility}"
        Click="CursorControl_Click">
    </ICBControls:FloatingBarControl>
</UserControl>

               