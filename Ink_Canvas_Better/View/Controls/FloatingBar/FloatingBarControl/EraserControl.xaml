<UserControl x:Class="Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl.EraserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl"
             xmlns:iuw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ICBControls="Ink_Canvas_Better.Controls"
             xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModel.Controls.FloatingBar.FloatingBarControl"
             d:DataContext="{d:DesignInstance Type=vm:EraserControlVM}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="IconAndText0" TargetType="{x:Type iuwm:IconAndText}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="IconSize" Value="28"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"/>
        </Style>
    </UserControl.Resources>
    
    <ICBControls:FloatingBarControl
        ImageSource="{DynamicResource Image.FUI.Eraser}"
        Text="{DynamicResource Text_Eraser}"
        TextVisibility="{Binding TextVisibility}"
        IsOpen="{Binding IsOpen, Mode=TwoWay}"
        StaysOpen="False"
        Click="EraserControl_Click">
        <ICBControls:FloatingBarControl.PopupContent>
            <iuw:SimpleStackPanel d:Background="AliceBlue" Orientation="Horizontal">
                <iuw:SimpleStackPanel>
                    <iuw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                        <Button Click="EraserControl_Clear" Padding="0" BorderThickness="0" VerticalAlignment="Top" Visibility="{Binding IsShowClearButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <iuwm:IconAndText
                                Icon="{x:Static iuwm:FluentSystemIcons.Delete_24_Regular}"
                                Content="{DynamicResource Text_Clear}"
                                Style="{StaticResource IconAndText0}"/>
                        </Button>
                        <iuwm:GridView Name="GridView_EraserType" SelectionChanged="GridView_EraserType_SelectionChanged" SelectedIndex="{Binding GridViewSelectedIndex}">
                            <iuwm:GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <iuw:SimpleStackPanel Orientation="Horizontal" MinWidth="200"/>
                                </ItemsPanelTemplate>
                            </iuwm:GridView.ItemsPanel>
                            <iuwm:GridView.Items>
                                <iuwm:IconAndText Icon="{x:Static iuwm:FluentSystemIcons.Eraser_20_Regular}"
                                                  Content="{DynamicResource Text_EraseByStroke}"
                                                  Style="{StaticResource IconAndText0}"/>
                                <iuwm:IconAndText Icon="{x:Static iuwm:FluentSystemIcons.CircleEraser_20_Filled}"
                                                  Content="{DynamicResource Text_EraseByEllipsePoint}"
                                                  Style="{StaticResource IconAndText0}"/>
                                <iuwm:IconAndText Icon="{x:Static iuwm:FluentSystemIcons.SquareEraser_20_Filled}"
                                                  Content="{DynamicResource Text_EraseBySquarePoint}"
                                                  Style="{StaticResource IconAndText0}"/>
                            </iuwm:GridView.Items>
                        </iuwm:GridView>
                    </iuw:SimpleStackPanel>
                    <Grid ColumnDefinitions="Auto,4,*" RowDefinitions="Auto">
                        <TextBlock
                            Grid.Row="0" Grid.Column="0"
                            Text="{DynamicResource Text_Thickness}"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"/>
                        <Slider
                            Grid.Row="0" Grid.Column="2" Name="Slider_Thickness" Orientation="Horizontal"
                            TickPlacement="Both"
                            IsMoveToPointEnabled="True"
                            TickFrequency="5"
                            AutoToolTipPlacement="TopLeft"
                            Maximum="170"
                            Minimum="1"
                            Value="{Binding Thickness}"
                            ValueChanged="Slider_Thickness_ValueChanged"/>
                    </Grid>
                </iuw:SimpleStackPanel>
                <Grid Height="170" Width="170">
                    <Rectangle Fill="#A2A2A2"
                               Height="{Binding Thickness}"
                               Width="{Binding Thickness}"/>
                    <Ellipse Fill="#A2A2A2"
                             Height="{Binding Thickness}"
                             Width="{Binding Thickness}"/>
                </Grid>
            </iuw:SimpleStackPanel>
        </ICBControls:FloatingBarControl.PopupContent>
    </ICBControls:FloatingBarControl>
</UserControl>
