<UserControl x:Class="Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModel.Controls.FloatingBar.FloatingBarControl"
             d:DataContext="{d:DesignInstance Type=vm:SettingsControlVM}"
             mc:Ignorable="d">
    <Grid d:Background="AliceBlue" Width="64" Height="64" Background="Transparent" MouseUp="SettingsControl_MouseUp">
        <StackPanel Name="StackPanel" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="{DynamicResource Image.FUI.Settings}"
                   Width="40"
                   Height="40"/>
            <TextBlock FontSize="12"
                       TextAlignment="Center"
                       Text="{DynamicResource Text_Setting}"
                       Visibility="{Binding TextVisibility}"
                       Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"/>
        </StackPanel>
    </Grid>
</UserControl>
