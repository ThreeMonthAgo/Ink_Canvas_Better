<UserControl x:Class="Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl"
             xmlns:ICBControls="Ink_Canvas_Better.Controls"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModel.Controls.FloatingBar.FloatingBarControl"
             Loaded="SettingsControl_Loaded"
             d:DataContext="{d:DesignInstance Type=vm:SettingsControlVM}"
             mc:Ignorable="d">
    <ICBControls:FloatingBarButton
        Icon="{x:Static iuwm:FluentSystemIcons.Settings_24_Regular}"
        Text="{DynamicResource Text_Setting}"
        TextVisibility="{Binding TextVisibility}"
        Click="SettingsControl_Click">
    </ICBControls:FloatingBarButton>
</UserControl>
