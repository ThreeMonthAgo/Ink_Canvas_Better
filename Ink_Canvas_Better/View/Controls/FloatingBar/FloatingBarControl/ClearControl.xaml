<UserControl x:Class="Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl.ClearControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ink_Canvas_Better.View.Controls.FloatingBar.FloatingBarControl"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ICBControls="Ink_Canvas_Better.Controls"
             xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModel.Controls.FloatingBar.FloatingBarControl"
             d:DataContext="{d:DesignInstance Type=vm:ClearControlVM}"
             mc:Ignorable="d">
    <ICBControls:FloatingBarControl
        Icon="{x:Static iuwm:FluentSystemIcons.Delete_24_Regular}"
        Text="{DynamicResource Text_Clear}"
        TextVisibility="{Binding TextVisibility}"
        Click="ClearControl_Click">
    </ICBControls:FloatingBarControl>
</UserControl>
