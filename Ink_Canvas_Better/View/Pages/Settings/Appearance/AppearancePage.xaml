<Page x:Class="Ink_Canvas_Better.View.Pages.Settings.Appearance.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:iuw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{DynamicResource Text_Appearance}">

    <ScrollViewer PanningMode="VerticalOnly">
        <iuw:SimpleStackPanel Spacing="4" Margin="16,4">
            <iuwm:SettingsCard Header="{DynamicResource Text_Setting_Theme}">
                <iuwm:SettingsCard.HeaderIcon>
                    <iuwm:FontIcon Icon="{x:Static iuwm:SegoeFluentIcons.Light}"/>
                </iuwm:SettingsCard.HeaderIcon>
                <iuwm:SettingsCard.Content>
                    <ComboBox Name="Theme_ComboBox" SelectionChanged="Theme_SelectionChanged" SelectedIndex="{Binding Settings.Theme}">
                        <ComboBoxItem Content="{DynamicResource Text_Setting_Auto}"/>
                        <ComboBoxItem Content="{DynamicResource Text_Setting_Light}"/>
                        <ComboBoxItem Content="{DynamicResource Text_Setting_Dark}"/>
                    </ComboBox>
                </iuwm:SettingsCard.Content>
            </iuwm:SettingsCard>
        </iuw:SimpleStackPanel>
    </ScrollViewer>
</Page>
