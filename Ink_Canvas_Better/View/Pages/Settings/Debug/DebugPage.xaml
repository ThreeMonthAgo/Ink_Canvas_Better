<Page x:Class="Ink_Canvas_Better.View.Pages.Settings.Debug.DebugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:iuw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:local="clr-namespace:Ink_Canvas_Better.View.Pages.Settings.Debug"
      mc:Ignorable="d"
      d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=local:DebugPage}"
      Title="DebugPage"
      Loaded="Page_Loaded">

    <ScrollViewer PanningMode="VerticalOnly">
        <iuw:SimpleStackPanel Spacing="4" Margin="16,4">
            <iuwm:SettingsExpander Header="{DynamicResource Text_Debug_Screen}" d:IsExpanded="True">
                <iuwm:SettingsExpander.HeaderIcon>
                    <iuwm:FontIcon Icon="{x:Static iuwm:SegoeFluentIcons.TVMonitor}"/>
                </iuwm:SettingsExpander.HeaderIcon>
                <iuwm:SettingsExpander.Items>
                    <iuwm:SettingsCard ContentAlignment="Left">
                        <DataGrid ItemsSource="{Binding Screens}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="name"  Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="flag"  Binding="{Binding Flags}"/>
                                <DataGridTextColumn Header="x"  Binding="{Binding X}"/>
                                <DataGridTextColumn Header="y"  Binding="{Binding Y}"/>
                                <DataGridTextColumn Header="width"  Binding="{Binding Width}"/>
                                <DataGridTextColumn Header="height"  Binding="{Binding Height}"/>
                                <DataGridTextColumn Header="work area width"  Binding="{Binding WkaWidth}"/>
                                <DataGridTextColumn Header="work area height"  Binding="{Binding WkaHeight}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </iuwm:SettingsCard>
                </iuwm:SettingsExpander.Items>
            </iuwm:SettingsExpander>
            <iuwm:SettingsExpander Header="FloatingBar" d:IsExpanded="True">
                <iuwm:SettingsExpander.HeaderIcon>
                    <iuwm:FontIcon Icon="{x:Static iuwm:SegoeFluentIcons.InkingTool}"/>
                </iuwm:SettingsExpander.HeaderIcon>
                <iuwm:SettingsExpander.Items>
                    <iuwm:SettingsCard ContentAlignment="Left">
                        <DataGrid ItemsSource="{Binding FloatingBarCollection}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="screen index"  Binding="{Binding ScreenIndex}"/>
                                <DataGridTextColumn Header="x"  Binding="{Binding X}"/>
                                <DataGridTextColumn Header="y"  Binding="{Binding Y}"/>
                                <DataGridTextColumn Header="width"  Binding="{Binding Width}"/>
                                <DataGridTextColumn Header="height"  Binding="{Binding Height}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </iuwm:SettingsCard>
                </iuwm:SettingsExpander.Items>
            </iuwm:SettingsExpander>
            <iuwm:SettingsExpander Header="Debug" d:IsExpanded="true">
                <iuwm:SettingsExpander.Items>
                    <iuwm:SettingsCard ContentAlignment="Left">
                        <Button Click="Button_Save_Strokes" Content="(Debug) Save strokes"/>
                    </iuwm:SettingsCard>
                    <iuwm:SettingsCard ContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="Button_Load_Strokes">
                                <TextBlock Text="(Debug) Load strokes from" VerticalAlignment="Center"/>
                            </Button>
                            <TextBox Name="TextBox_StrokeFilePath"/>
                        </StackPanel>
                    </iuwm:SettingsCard>
                </iuwm:SettingsExpander.Items>
            </iuwm:SettingsExpander>
        </iuw:SimpleStackPanel>
    </ScrollViewer>
</Page>
