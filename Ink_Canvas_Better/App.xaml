<Application x:Class="Ink_Canvas_Better.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ink_Canvas_Better"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:Converter="Ink_Canvas_Better.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <iuwm:ThemeResources/>
                <iuwm:XamlControlsResources/>

                <ResourceDictionary Source="/Themes/Image/Light/DrawShapeImageDictionary.xaml"/>
                <ResourceDictionary Source="/Themes/Image/Light/OthersImageDictionary.xaml"/>
                <ResourceDictionary Source="/Themes/Language/en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters -->
            <Converter:AlphaToOpactiyConverter x:Key="AlphaToOpacityConverter"/>
            <Converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
