<Application x:Class="Ink_Canvas_Better.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ink_Canvas_Better"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <iuwm:ThemeResources/>
                <iuwm:XamlControlsResources/>

                <ResourceDictionary Source="/Themes/Image/Light/DrawShapeImageDictionary.xaml"/>
                <ResourceDictionary Source="/Themes/Image/Light/OthersImageDictionary.xaml"/>
                <ResourceDictionary Source="/Themes/Image/Light/FluentUIIcons/FluentUIIcons.xaml"/>
                <ResourceDictionary Source="/Themes/Language/en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--#region Styles-->
            <!-- Image -->
            <Style x:Key="PinButtonImageStyle" TargetType="{x:Type Image}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=StaysOpen, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PinOffButtonImageStyle" TargetType="{x:Type Image}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=StaysOpen, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Button and ToggleButton-->
            <Style x:Key="PinToggleButtonStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"/>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"/>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--#endregion-->
        </ResourceDictionary>
    </Application.Resources>
</Application>
