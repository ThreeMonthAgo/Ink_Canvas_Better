
    <Application x:Class="Ink_Canvas_Better.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ink_Canvas_Better"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:converter="clr-namespace:Ink_Canvas_Better.Helpers.Converter"
             xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModels.Controls.FloatingBar"
             xmlns:vm1="clr-namespace:Ink_Canvas_Better.ViewModels.Controls.FloatingBar.FloatingBarControl"
             xmlns:v="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar"
             xmlns:v1="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <iuwm:ThemeResources/>
                <iuwm:XamlControlsResources/>

                <ResourceDictionary Source="/Themes/Image/Light/DrawShapeImageDictionary.xaml"/>
                <ResourceDictionary Source="/Themes/Image/Light/OthersImageDictionary.xaml"/>
                <ResourceDictionary Source="/Themes/Image/Light/FluentUIIcons/FluentUIIcons.xaml"/>
                <ResourceDictionary Source="/Themes/Language/en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters -->
            <converter:AlphaToOpactiyConverter x:Key="AlphaToOpacityConverter"/>
            <!--#region Styles-->
            <!-- Image -->
            <Style x:Key="PinButtonImageStyle" TargetType="{x:Type Image}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=StaysOpen, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PinOffButtonImageStyle" TargetType="{x:Type Image}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=StaysOpen, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Button and ToggleButton -->
            <Style x:Key="PinToggleButtonStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Grid>
                                <Image Source="{DynamicResource Image.FUI.PinOff}" Style="{StaticResource PinOffButtonImageStyle}"/>
                                <Image Source="{DynamicResource Image.FUI.Pin}" Style="{StaticResource PinButtonImageStyle}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"/>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Image Source="{DynamicResource Image.FUI.Dismiss}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"/>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--#endregion-->
        </ResourceDictionary>
    </Application.Resources>
</Application>
