<UserControl xmlns:base="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar"
             x:Class="Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl.CursorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:Ink_Canvas_Better.Behaviors"
             xmlns:local="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModels.Controls.FloatingBar.FloatingBarControl"
             d:DataContext="{d:DesignInstance Type=vm:CursorControlVM}"
             mc:Ignorable="d">
    <Grid Name="Grid" Background="Transparent" d:Background="AliceBlue" Width="64" Height="64">
        <StackPanel Background="Transparent" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" MouseUp="CursorControl_MouseUp">
            <Image Source="{DynamicResource Image.FUI.Cursor}"
                   Width="40"
                   Height="40"/>
            <TextBlock FontSize="12"
                       TextAlignment="Center"
                       Text="{DynamicResource Text_Cursor}"
                       Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"
                       Visibility="{Binding TextVisibility}"/>
        </StackPanel>
    </Grid>
</UserControl>

               