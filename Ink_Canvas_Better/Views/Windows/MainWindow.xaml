<Window x:Class="Ink_Canvas_Better.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ink_Canvas_Better.Windows"
        xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModels.Windows"
        xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowVM}"
        Title="{DynamicResource Text_ProductName}">
    <Grid Background="Transparent">
        <InkCanvas
            Name="MW_InkCanvas"
            Background="Transparent"
            Cursor="Pen"
            DefaultDrawingAttributes="{Binding CurrentDrawingAttributes}"
            ForceCursor="False"
            IsManipulationEnabled="True"/>
        <Grid ColumnDefinitions="auto">
            <ContentControl Grid.Column="0" Content="{Binding FloatingBarCollection[0]}"/>
            <!--<iuwm:ItemsRepeater Grid.Column="0" Name="MW_ItemsPresenter" ItemsSource="{Binding FloatingBarCollection}"/>-->
        </Grid>
    </Grid>
</Window>
