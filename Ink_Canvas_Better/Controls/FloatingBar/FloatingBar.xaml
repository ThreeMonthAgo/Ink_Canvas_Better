<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:local="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar">

    <Style TargetType="{x:Type local:FloatingBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FloatingBar}">
                    <iuwm:ItemsRepeater
                        ItemsSource="{TemplateBinding ItemsSource}">
                        <iuwm:ItemsRepeater.Layout>
                            <iuwm:StackLayout Spacing="{TemplateBinding Spacing}" Orientation="{TemplateBinding Orientation}" />
                        </iuwm:ItemsRepeater.Layout>
                    </iuwm:ItemsRepeater>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>