<local:FloatingBarComponentBase x:Class="Ink_Canvas_Better.Controls.FloatingBar.FloatingBar"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                                xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
                                xmlns:local="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar"
                                xmlns:iuw="http://schemas.inkore.net/lib/ui/wpf"
                                mc:Ignorable="d">
    <ItemsControl ItemsSource="{Binding Settings.Items, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBar}}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <iuw:SimpleStackPanel Spacing="{Binding Spacing, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBar}}}"
                                      Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBar}}}"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</local:FloatingBarComponentBase>
