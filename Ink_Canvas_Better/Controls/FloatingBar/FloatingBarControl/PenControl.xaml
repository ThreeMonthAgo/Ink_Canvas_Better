<UserControl xmlns:base="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar"
             x:Class="Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl.PenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl"
             xmlns:subpanel="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar.SubPanel"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             mc:Ignorable="d">
    <Grid Background="Transparent" d:Background="AliceBlue" Width="64" Height="64">
        <Popup Name="Subpanel"
               PlacementTarget="{Binding ElementName=StackPanel}"
               IsOpen="{Binding IsOpen, Mode=TwoWay}"
               StaysOpen="{Binding StaysOpen}"
               PopupAnimation="{Binding PopupAnimation}"
               Margin="4"
               AllowsTransparency="True">
            <Border CornerRadius="{Binding CornerRadius}"
                    Background="{DynamicResource {x:Static iuwm:ThemeKeys.ApplicationPageBackgroundThemeBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeBrushKey}}"
                    BorderThickness="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeThicknessKey}}"
                    Padding="4">
                <StackPanel Orientation="Vertical" MinWidth="100">
                    <Grid ColumnDefinitions="*,auto,auto">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"
                                   Text="{DynamicResource Text_Pen}"
                                   Grid.Column="0"
                                   FontSize="24"/>
                        <Button Grid.Column="1" Width="30" Height="30" Padding="4">
                            <Image Source="{DynamicResource Image.FUI.Pin}"/>
                        </Button>
                        <Button Grid.Column="2" Width="30" Height="30" Padding="4">
                            <Image Source="{DynamicResource Image.FUI.Dismiss}"/>
                        </Button>
                    </Grid>
                    <ContentPresenter Content="{Binding PenControlSettings.SubpanelUI}"/>
                </StackPanel>
            </Border>
        </Popup>
        <StackPanel Name="StackPanel" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="{DynamicResource Image.FUI.CalligraphyPen}"
                   d:Width="40"
                   d:Height="40"
                   Width="{Binding ImageWidth}"
                   Height="{Binding ImageHeight}"/>
            <TextBlock FontSize="12"
                       TextAlignment="Center"
                       Text="{DynamicResource Text_Pen}"
                       Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"
                       Visibility="{Binding TextVisibility}"/>
        </StackPanel>
    </Grid>
</UserControl>
               