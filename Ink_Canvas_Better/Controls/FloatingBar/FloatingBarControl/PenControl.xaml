<UserControl xmlns:base="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar"
             x:Class="Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl.PenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:Ink_Canvas_Better.Behaviors"
             xmlns:local="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl"
             xmlns:iuw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:vm="clr-namespace:Ink_Canvas_Better.ViewModels.Controls.FloatingBar.FloatingBarControl"
             d:DataContext="{d:DesignInstance Type=vm:PenControlVM}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="Rectangle" x:Key="Colors">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="RadiusX" Value="4" />
            <Setter Property="RadiusY" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid Name="Grid" Background="Transparent" d:Background="AliceBlue" Width="64" Height="64">
        <Popup Name="Subpanel"
               Placement="Top"
               PlacementTarget="{Binding ElementName=Grid}"
               IsOpen="{Binding IsOpen, Mode=TwoWay}"
               StaysOpen="False"
               PopupAnimation="Fade"
               AllowsTransparency="True">
            <Border Padding="0,4">
                <Border CornerRadius="4"
                        Background="{DynamicResource {x:Static iuwm:ThemeKeys.ApplicationPageBackgroundThemeBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeBrushKey}}"
                        BorderThickness="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeThicknessKey}}"
                        Padding="4">
                    <StackPanel Orientation="Vertical" MinWidth="100">
                        <Grid ColumnDefinitions="*,auto,4,auto" Name="Grid_TitleBar">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"
                                       Text="{DynamicResource Text_Pen}"
                                       Grid.Column="0"
                                       FontSize="24"/>
                            <Thumb Background="Transparent" Opacity="0.2">
                                <bh:Interaction.Behaviors>
                                    <behavior:DragBehavior TypeOfControlToDrag="{x:Type Popup}" IsUseLogicalTreeHelper="True"/>
                                </bh:Interaction.Behaviors>
                            </Thumb>
                            <ToggleButton Grid.Column="1" Width="26" Height="26" Style="{StaticResource PinToggleButtonStyle}" IsChecked="{Binding ElementName=Subpanel, Path=StaysOpen, Mode=TwoWay}"/>
                            <Button Grid.Column="3" Width="26" Height="26" Style="{StaticResource CloseButtonStyle}">
                                <bh:Interaction.Behaviors>
                                    <behavior:CloseButtonBehavior/>
                                </bh:Interaction.Behaviors>
                            </Button>
                        </Grid>
                        <!--#region Subpanel-->
                        <iuw:SimpleStackPanel d:Background="AliceBlue" Orientation="Horizontal">
                            <iuw:SimpleStackPanel>
                                <iuw:SimpleStackPanel Orientation="Horizontal">
                                    <Popup Name="Popup_ColorPicker" Placement="Top" AllowsTransparency="True">
                                        <Border CornerRadius="4"
                                                Background="{DynamicResource {x:Static iuwm:ThemeKeys.ApplicationPageBackgroundThemeBrushKey}}"
                                                BorderBrush="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeBrushKey}}"
                                                BorderThickness="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeThicknessKey}}"
                                                Padding="4">
                                            <iuw:SimpleStackPanel>
                                                <iuw:SquarePicker Height="180" Width="180" Name="SqColorPicker" ColorChanged="SqColorPicker_ColorChanged"/>
                                                <Button Content="{DynamicResource Text_Confirm}" Width="180">
                                                    <bh:Interaction.Behaviors>
                                                        <behavior:CloseButtonBehavior/>
                                                    </bh:Interaction.Behaviors>
                                                </Button>
                                            </iuw:SimpleStackPanel>
                                        </Border>
                                    </Popup>
                                    <iuwm:GridView Name="GridView_Colors"
                                                   IsItemClickEnabled="True"
                                                   ItemsSource="{Binding ColorCollection}"
                                                   SelectionChanged="GridView_Colors_SelectionChanged"
                                                   SelectedIndex="{Binding GridViewSelectedIndex}">
                                        <iuwm:GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="6"/>
                                            </ItemsPanelTemplate>
                                        </iuwm:GridView.ItemsPanel>
                                        <iuwm:GridView.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle Style="{StaticResource Colors}" Fill="{Binding}"/>
                                            </DataTemplate>
                                        </iuwm:GridView.ItemTemplate>
                                    </iuwm:GridView>
                                    <iuw:SimpleStackPanel Spacing="4">
                                        <ToggleButton Width="44" Height="44" Padding="0" Name="Toggle_Color">
                                            <iuwm:IconAndText Icon="{x:Static iuwm:FluentSystemIcons.Color_24_Regular}" Content="{DynamicResource Text_Color}" Orientation="Vertical" Spacing="0" FontSize="10"/>
                                        </ToggleButton>
                                        <ToggleButton Width="44" Height="44" Visibility="Collapsed"/>
                                    </iuw:SimpleStackPanel>
                                </iuw:SimpleStackPanel>
                                <Grid ColumnDefinitions="Auto,4,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{DynamicResource Text_Thickness}"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"/>
                                    <Slider Grid.Row="0" Grid.Column="2" Name="Slider_Thickness" Orientation="Horizontal"
                                            TickPlacement="Both"
                                            IsMoveToPointEnabled="True"
                                            TickFrequency="5"
                                            AutoToolTipPlacement="TopLeft"
                                            Maximum="170"
                                            Minimum="1"
                                            Value="{Binding Thickness}"
                                            ValueChanged="Slider_Thickness_ValueChanged"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{DynamicResource Text_Alpha}"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"/>
                                    <Slider Grid.Row="1" Grid.Column="2" Name="Slider_Alpha" Orientation="Horizontal"
                                            TickPlacement="Both"
                                            IsMoveToPointEnabled="True"
                                            TickFrequency="5"
                                            AutoToolTipPlacement="TopLeft"
                                            Maximum="255"
                                            Minimum="0"
                                            Value="{Binding Alpha}"
                                            ValueChanged="Slider_Alpha_ValueChanged"/>
                                </Grid>
                            </iuw:SimpleStackPanel>
                            <Grid Height="170" Width="170">
                                <Ellipse Fill="{Binding EllipseFill}"
                                         Height="{Binding ElementName=Slider_Thickness, Path=Value}"
                                         Width="{Binding ElementName=Slider_Thickness, Path=Value}"
                                         Opacity="{Binding ElementName=Slider_Alpha, Path=Value, Converter={StaticResource AlphaToOpacityConverter}}"/>
                            </Grid>
                        </iuw:SimpleStackPanel>
                        <!--#endregion Subpanel-->
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
        <StackPanel Background="Transparent" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" MouseUp="PenControl_MouseUp">
            <Image Source="{DynamicResource Image.FUI.CalligraphyPen}"
                   Width="40"
                   Height="40"/>
            <TextBlock FontSize="12"
                       TextAlignment="Center"
                       Text="{DynamicResource Text_Pen}"
                       Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"
                       Visibility="{Binding TextVisibility}"/>
        </StackPanel>
    </Grid>
</UserControl>
