<UserControl xmlns:base="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar"
             x:Class="Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl.MultifunctionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl"
             xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             mc:Ignorable="d" >
    <Grid d:Background="AliceBlue" Width="64" Height="64">
        <StackPanel Name="StackPanel" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="{DynamicResource Image.FUI.Drag}"
                   d:Width="40"
                   d:Height="40"
                   Width="{Binding ImageWidth, RelativeSource={RelativeSource AncestorType={x:Type local:MultifunctionControl}}}"
                   Height="{Binding ImageHeight, RelativeSource={RelativeSource AncestorType={x:Type local:MultifunctionControl}}}"/>
        </StackPanel>
    </Grid>
</UserControl>
