<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Ink_Canvas_Better.Controls"
                    xmlns:iUW="http://schemas.inkore.net/lib/ui/wpf">

    <Style TargetType="{x:Type local:Subpanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Subpanel}">
                    <Popup IsOpen="{TemplateBinding IsOpen}"
                                   StaysOpen="{TemplateBinding StaysOpen}"
                                   AllowsTransparency="{TemplateBinding AllowsTransparency}"
                                   Placement="{TemplateBinding Placement}"
                                   PlacementTarget="{TemplateBinding PlacementTarget}"
                                   PlacementRectangle="{TemplateBinding PlacementRectangle}"
                                   PopupAnimation="{TemplateBinding PopupAnimation}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Vertical">
                                <Grid Height="{TemplateBinding TitleBarHeight}">
                                    <TextBlock HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               Text="{TemplateBinding Title}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                        <ToggleButton Name="PART_PinToggleButton"
                                                      BorderThickness="0"
                                                      Background="Transparent"/>
                                        <Button Name="PART_CloseButton"
                                                BorderThickness="0"
                                                Background="Transparent"/>
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>