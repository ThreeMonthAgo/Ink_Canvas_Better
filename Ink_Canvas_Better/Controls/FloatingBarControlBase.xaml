<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Ink_Canvas_Better.Controls"
                    xmlns:iUW="http://schemas.inkore.net/lib/ui/wpf">

    <Style TargetType="{x:Type local:FloatingBarControlBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.Setters>
                    <!-- Temp -->
                    <Setter Property="Background" Value="AntiqueWhite"/>
                </Trigger.Setters>
            </Trigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FloatingBarControlBase}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}"/> <!-- For Subpanel or the other popup only -->
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="{TemplateBinding Source}"
                                       Width="{TemplateBinding ImageWidth}"
                                       Height="{TemplateBinding ImageHeight}"/>
                                <TextBlock FontSize="12"
                                           TextAlignment="Center"
                                           Text="{TemplateBinding Text}"
                                           Visibility="{TemplateBinding TextVisibility}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>