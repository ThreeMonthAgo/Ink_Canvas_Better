<UserControl x:Class="Ink_Canvas_Better.Controls.FloatingBarControls.FloatingBarControlBase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iUW="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:iUWM="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:local="clr-namespace:Ink_Canvas_Better.Controls.FloatingBarControls"
             mc:Ignorable="d">
    <Border x:Name="Border">
        <Button x:Name="Button" Width="64" Height="64" Background="Transparent" Padding="0">
            <iUW:SimpleStackPanel x:Name="SimpleStackPanel">
                <Image x:Name="Image" Height="48" Width="48"/>
                <TextBlock x:Name="TextBlock" FontSize="8" TextAlignment="Center" Visibility="Collapsed"/>
            </iUW:SimpleStackPanel>
        </Button>
    </Border>
</UserControl>
