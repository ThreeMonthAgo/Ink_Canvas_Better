<Window x:Class="Ink_Canvas_Better.Windows.Language"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ink_Canvas_Better"
        xmlns:iuw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
        iuwm:WindowHelper.UseModernWindowStyle="True"
        iuwm:WindowHelper.SystemBackdropType="Mica"
        iuwm:TitleBar.Height="36"
        WindowStyle="SingleBorderWindow"
        Topmost="True"
        mc:Ignorable="d"
        Title="Ink Cnavas Better Language" Height="450" Width="800">
    <DockPanel Margin="15">
        <iuw:SimpleStackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Spacing="10" Height="30" HorizontalAlignment="Right">
            <Button Name="Cancel" Width="150" Content="{DynamicResource Text_Cancel}" Click="ButtonCancel_Click"/>
            <Button Name="OK" Width="150" Content="{DynamicResource Text_Confirm}" IsEnabled="False" Click="ButtonOK_Click" Style="{StaticResource {x:Static iuwm:ThemeKeys.AccentButtonStyleKey}}"/>
        </iuw:SimpleStackPanel>
        <iuwm:IconAndText
            IconSize="24"
            FontSize="24"
            DockPanel.Dock="Top"
            HorizontalAlignment="Left"
            Icon="{x:Static iuwm:SegoeFluentIcons.LocaleLanguage}"
            Content="{DynamicResource Text_Setting_Language}"/>
        <ListBox Name="LanguageListBox" SelectionChanged="LanguageListBox_SelectionChanged" Margin="4,10"/>
    </DockPanel>
</Window>
