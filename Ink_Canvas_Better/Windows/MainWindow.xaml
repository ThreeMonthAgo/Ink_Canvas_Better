<Window x:Class="Ink_Canvas_Better.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ink_Canvas_Better.Windows"
        xmlns:services="clr-namespace:Ink_Canvas_Better.Services"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Title="{DynamicResource Text_ProductName}">
    <Grid Background="Transparent">
        <InkCanvas
            Name="MW_InkCanvas"
            Background="Transparent"
            Cursor="Pen"
            ForceCursor="False"
            IsManipulationEnabled="True"/>
        <Canvas Name="MW_Canvas"/>
    </Grid>
</Window>
