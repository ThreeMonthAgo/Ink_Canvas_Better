<Window x:Class="Ink_Canvas_Better.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
        xmlns:localControls="clr-namespace:Ink_Canvas_Better.Controls"
        xmlns:local="clr-namespace:Ink_Canvas_Better"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:icb="Ink_Canvas_Better.Controls"
        Title="{DynamicResource Text_ProductName}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowState="Maximized">
    <Window.Resources>
        <Style x:Key="SubpanelStyle" TargetType="icb:Subpanel">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="IsOpen" Value="False"/>
            <Setter Property="StaysOpen" Value="False"/>
        </Style>
    </Window.Resources>
    
    <Grid
        Name="MainWindow_Grid"
        Background="Transparent">
        <!-- 
        <InkCanvas
            x:Name="inkCanvas"
            Background="Transparent"
            Cursor="Pen"
            ForceCursor="False"
            IsManipulationEnabled="True"
            EditingModeChanged=""
            ManipulationCompleted=""
            ManipulationDelta=""
            ManipulationInertiaStarting=""
            ManipulationStarting=""
            MouseDown=""
            MouseMove=""
            MouseUp=""
            PreviewTouchDown=""
            PreviewTouchUp=""
            SelectionChanged=""
            StrokeCollected=""
            TouchDown=""
            TouchMove=""
            TouchUp=""
            TouchDown="MainInkCanvas_TouchDown"
            TouchMove="MainInkCanvas_TouchMove"
            TouchUp="MainInkCanvas_TouchUp"
            MouseDown="MainInkCanvas_MouseDown"
            MouseMove="MainInkCanvas_MouseMove"
            MouseUp="MainInkCanvas_MouseUp"/>
        -->
        <!--  // Canvas //  -->
        <InkCanvas
            x:Name="MainInkCanvas"
            Background="Transparent"
            Cursor="Pen"
            ForceCursor="False"
            IsManipulationEnabled="True">
        </InkCanvas>
    </Grid>
</Window>
