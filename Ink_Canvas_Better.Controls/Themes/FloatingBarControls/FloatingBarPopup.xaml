<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iuwm="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:local="clr-namespace:Ink_Canvas_Better.Controls.FloatingBarControls"
                    xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:behavior="clr-namespace:Ink_Canvas_Better.Controls.Behaviors">
    <Style TargetType="{x:Type local:FloatingBarPopup}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FloatingBarPopup}">
                    <Grid x:Name="PART_MainGrid" Background="Transparent" Width="64" Height="64">
                        <Popup
                            x:Name="PART_Popup"
                            Placement="Top"
                            StaysOpen="{TemplateBinding StaysOpen}"
                            PopupAnimation="Fade"
                            AllowsTransparency="True">
                            <Border
                                CornerRadius="4"
                                Background="{DynamicResource {x:Static iuwm:ThemeKeys.ApplicationPageBackgroundThemeBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeBrushKey}}"
                                BorderThickness="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeThicknessKey}}"
                                Padding="4">
                                <StackPanel Orientation="Vertical" MinWidth="100">
                                    <!-- Title Bar -->
                                    <Border
                                        BorderBrush="{DynamicResource {x:Static iuwm:ThemeKeys.FlyoutBorderThemeBrushKey}}"
                                        BorderThickness="0,0,0,0.8">
                                        <Grid ColumnDefinitions="*,auto,0,auto" Name="Grid_TitleBar">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"
                                                Text="{TemplateBinding Text}"
                                                Grid.Column="0"
                                                FontSize="24"/>
                                            <Thumb Background="Transparent" Opacity="0.2">
                                                <bh:Interaction.Behaviors>
                                                    <behavior:DragBehavior TypeOfControlToDrag="{x:Type Popup}" IsUseLogicalTreeHelper="True"/>
                                                </bh:Interaction.Behaviors>
                                            </Thumb>
                                            <ToggleButton
                                                Grid.Column="1"
                                                x:Name="PART_ToggleButton"
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                Background="Transparent">
                                                <iuwm:FontIcon x:Name="PART_ToggleButton_FontIcon" Icon="{x:Static iuwm:SegoeFluentIcons.Unpin}" FontSize="20"/>
                                            </ToggleButton>
                                            <Button
                                                Grid.Column="3"
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                Background="Transparent">
                                                <iuwm:FontIcon Icon="{x:Static iuwm:SegoeFluentIcons.Cancel}" FontSize="24"/>
                                                <bh:Interaction.Behaviors>
                                                    <behavior:CloseButtonBehavior/>
                                                </bh:Interaction.Behaviors>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <!-- Subpanel Content -->
                                    <ContentControl Content="{TemplateBinding PopupContent}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Grid Background="Transparent" x:Name="PART_Grid">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid>
                                    <Image
                                        Source="{TemplateBinding ImageSource}"
                                        Width="40"
                                        Height="40"/>
                                    <iuwm:FontIcon
                                        Icon="{TemplateBinding Icon}"
                                        Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"
                                        Width="40"
                                        Height="40"
                                        FontSize="40"/>
                                </Grid>
                                <TextBlock
                                    FontSize="12"
                                    TextAlignment="Center"
                                    Text="{TemplateBinding Text}"
                                    Foreground="{DynamicResource {x:Static iuwm:ThemeKeys.ButtonForegroundKey}}"
                                    Visibility="{TemplateBinding TextVisibility}"/>
                            </StackPanel>
                            <!-- Extra content -->
                            <ContentPresenter Content="{TemplateBinding ExtraContent}"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>