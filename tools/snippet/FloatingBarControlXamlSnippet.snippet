<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
   <CodeSnippet Format="1.0.0">
       <Header>
           <Title>FloatingBarControl Xaml Code Snippet</Title>
           <Shortcut>fbcx</Shortcut> <!-- FloatingBarControl Xaml -->
           <Description>Create a xaml code snippet of FloatingBarControl</Description>
           <Author>Ink Canvas Better</Author>
       </Header>
       <Snippet>
		   <Declarations>
			   <Literal>
				   <ID>FloatingBarControlName</ID>
				   <Default>Name</Default>
			   </Literal>
		   </Declarations>
           <Code Language="xaml">
               <![CDATA[
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl"
                    xmlns:iUWM="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:iUW="http://schemas.inkore.net/lib/ui/wpf">

    <Style TargetType="{x:Type local:$FloatingBarControlName$}">
        <Style.Triggers>
            
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:$FloatingBarControlName$}">
                    <Border Background="Transparent">
                        <Grid Background="Transparent">
                            <Popup Placement="{TemplateBinding Placement}"
                                   PlacementRectangle="{TemplateBinding PlacementRectangle}"
                                   PlacementTarget="{TemplateBinding PlacementTarget}"
                                   IsOpen="{Binding Path=IsOpen,RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   StaysOpen="{TemplateBinding StaysOpen}"
                                   PopupAnimation="{TemplateBinding PopupAnimation}"
                                   Margin="4"
                                   AllowsTransparency="True">
                                <Border CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="{DynamicResource {x:Static iUWM:ThemeKeys.ApplicationPageBackgroundThemeBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static iUWM:ThemeKeys.FlyoutBorderThemeBrushKey}}"
                                        BorderThickness="{DynamicResource {x:Static iUWM:ThemeKeys.FlyoutBorderThemeThicknessKey}}">
                                    <StackPanel Orientation="Vertical" MinWidth="100">
                                        <Grid ColumnDefinitions="*,auto,auto">
                                            <TextBlock Text="{TemplateBinding Title}"
                                                       Grid.Column="0"
                                                       FontSize="20"/>
                                            <Button Grid.Column="1"/>
                                            <Button Grid.Column="2"/>
                                        </Grid>
                                        <ContentPresenter/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="{TemplateBinding Source}"
                                       Width="{TemplateBinding ImageWidth}"
                                       Height="{TemplateBinding ImageHeight}"/>
                                <TextBlock FontSize="12"
                                           TextAlignment="Center"
                                           Text="{TemplateBinding Text}"
                                           Visibility="{TemplateBinding TextVisibility}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
               ]]>
           </Code>
       </Snippet>
   </CodeSnippet>
</CodeSnippets>