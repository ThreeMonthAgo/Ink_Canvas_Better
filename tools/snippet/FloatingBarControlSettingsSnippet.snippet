using System;
using System.Collections.Generic;
using System.Text;

namespace Ink_Canvas_Better.Controls.FloatingBar.FloatingBarControl
{
    public class $FloatingBarControlName$Settings
    {

    }
}

               ]]>
           </Code>
       </Snippet>
   </CodeSnippet>
</CodeSnippets>