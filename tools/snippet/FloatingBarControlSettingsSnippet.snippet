<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
   <CodeSnippet Format="1.0.0">
       <Header>
           <Title>FloatingBarControl Settings Code Snippet</Title>
           <Shortcut>fbcs</Shortcut> <!-- FloatingBarControl Settings -->
           <Description>Create a settings code snippet of FloatingBarControl</Description>
           <Author>Ink Canvas Better</Author>
       </Header>
       <Snippet>
		   <Declarations>
			   <Literal>
				   <ID>FloatingBarControlName</ID>
				   <Default>Name</Default>
			   </Literal>
		   </Declarations>
           <Code Language="csharp">
